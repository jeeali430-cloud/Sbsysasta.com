NEXT_PUBLIC_SITE_URL=https://sbsysasta.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923202785197
NEXT_PUBLIC_SUPPORT_PHONE=03202785197

# ---------- Supabase ----------
# Find these in Supabase Studio → Project Settings → API
# Leave blank to run the site on the in-memory seed data — everything still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client. Used by /api/orders and the admin
# dashboard to bypass RLS. Required to persist orders or run admin pages.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin allowlist ----------
# Comma-separated emails that can access /admin (matched after Supabase Auth
# sign-in). Leave blank to allow ANY signed-in Supabase user — not recommended.
ADMIN_EMAILS=jeeali430@gmail.com
